APP_ENV=local
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_dev
TEST_DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_test

# Fernet key encrypting application_parties.ssn_encrypted at rest. Generate
# with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required whenever APP_ENV is not "test".
FIELD_ENCRYPTION_KEY=

VALKEY_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=clear-quote
S3_ACCESS_KEY=cq-minio
S3_SECRET_KEY=cq-minio-secret
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@clearquote.local

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=clear-quote-pipeline

CORS_ORIGINS=http://localhost:3010,http://localhost:3020

# CQ-009: mock adapter latency simulation (defaults: 200/1200/true). Set
# INTEGRATION_LATENCY_ENABLED=false to disable sleeping entirely.
INTEGRATION_LATENCY_MIN_MS=200
INTEGRATION_LATENCY_MAX_MS=1200
INTEGRATION_LATENCY_ENABLED=true

# CQ-013: fixed dev LO id `pricing.scenarios.deps.get_current_lo_stub()`
# returns until CQ-014 replaces it with real staff auth. Must be a `users.id`
# CQ-010's seed creates -- unset means every pricing route 401s. This value
# is Jordan Lee's pinned id in `seed/users.yaml` (`make demo-reset` always
# creates this exact row), so the pricing routes work out of the box against
# a freshly-reset local database.
DEV_LO_ID=00000000-0000-0000-0000-000000000001

# CQ-010 (review round 1, finding #3): shared demo password `make demo-reset`
# bcrypt-hashes for the 4 seeded staff users (2 LO, 1 Manager, 1 Admin). No
# default is committed -- `demo-reset` fails with a clear message if this is
# unset, rather than seeding a guessable/hardcoded password. Pick your own
# local value; login is unusable until CQ-014 wires real staff auth.
SEED_STAFF_PASSWORD=
