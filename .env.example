APP_ENV=local
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_dev
TEST_DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_test

# Fernet key encrypting application_parties.ssn_encrypted at rest. Generate
# with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required whenever APP_ENV is not "test".
FIELD_ENCRYPTION_KEY=

VALKEY_URL=redis://localhost:6379/0
# Tests FLUSHDB this db; defaults to VALKEY_URL with db 15 when unset.
# TEST_VALKEY_URL=redis://localhost:6379/15

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=clear-quote
S3_ACCESS_KEY=cq-minio
S3_SECRET_KEY=cq-minio-secret
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@clearquote.local

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=clear-quote-pipeline

CORS_ORIGINS=http://localhost:3010,http://localhost:3020

# CQ-014: optional overrides for session/OTP/rate-limit tuning. Defaults
# (in backend/app/core/config.py) are sane for local dev; uncomment to
# change them.
# STAFF_SESSION_TTL_SECONDS=43200
# BORROWER_SESSION_TTL_SECONDS=604800
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_PER_EMAIL=5
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# CQ-009: mock adapter latency simulation (defaults: 200/1200/true). Set
# INTEGRATION_LATENCY_ENABLED=false to disable sleeping entirely.
INTEGRATION_LATENCY_MIN_MS=200
INTEGRATION_LATENCY_MAX_MS=1200
INTEGRATION_LATENCY_ENABLED=true

# CQ-010 (review round 1, finding #3): shared demo password `make demo-reset`
# argon2-hashes (phase-p2 merge, X1) for the 4 seeded staff users (2 LO, 1
# Manager, 1 Admin). No default is committed -- `demo-reset` fails with a
# clear message if this is unset, rather than seeding a guessable/hardcoded
# password. Pick your own local value; sign in at the LO Console with any
# seeded staff email (see seed/users.yaml) and this password.
SEED_STAFF_PASSWORD=

# Optional shared password `make demo-reset` gives every persona client's
# borrower account (Borrower Portal login). Leave blank to skip borrower
# accounts. No default is committed.
SEED_BORROWER_PASSWORD=

# P5/P6 foundation (docs/backlog/phase-p5-p6-foundation.md). All optional.
# CQ-034 support email recipient.
# SUPPORT_INBOX=support@tql.local
# CQ-030 stale-quote Temporal Schedule interval.
# STALE_CHECK_INTERVAL_SECONDS=3600
# Freeze core/clock.now() for tests and demos (ISO-8601, e.g. 2026-10-17T12:00:00Z).
# CLOCK_NOW=

# CQ-028a: borrower-portal base URL used in email links (hard-pull consent).
# PORTAL_BASE_URL=http://localhost:3020
# CQ-034: base URL of the LO console, for the /applications/{id} link in the
# support-inbox email.
# LO_CONSOLE_BASE_URL=http://localhost:3010
