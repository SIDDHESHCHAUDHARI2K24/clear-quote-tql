APP_ENV=local
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_dev
TEST_DATABASE_URL=postgresql+asyncpg://cq:cq@localhost:5432/cq_test

# Fernet key encrypting application_parties.ssn_encrypted at rest. Generate
# with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required whenever APP_ENV is not "test".
FIELD_ENCRYPTION_KEY=

VALKEY_URL=redis://localhost:6379/0
# Tests FLUSHDB this db; defaults to VALKEY_URL with db 15 when unset.
# TEST_VALKEY_URL=redis://localhost:6379/15

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=clear-quote
S3_ACCESS_KEY=cq-minio
S3_SECRET_KEY=cq-minio-secret
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@clearquote.local

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=clear-quote-pipeline

CORS_ORIGINS=http://localhost:3010,http://localhost:3020

# CQ-014: dev-only passwords for the seeded lo@/manager@/admin@clearquote.test
# and (CQ-015) borrower@clearquote.test accounts. Never set outside local/CI.
DEMO_STAFF_PASSWORD=
DEMO_BORROWER_PASSWORD=

# CQ-014: optional overrides for session/OTP/rate-limit tuning. Defaults
# (in backend/app/core/config.py) are sane for local dev; uncomment to
# change them.
# STAFF_SESSION_TTL_SECONDS=43200
# BORROWER_SESSION_TTL_SECONDS=604800
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_PER_EMAIL=5
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
